#!/usr/bin/env python3
#MISE description="Create a service module from generate-module.d"

import os
from pathlib import Path
import re
import shutil
import subprocess
import sys


def main():
    if len(sys.argv) != 2 or not re.fullmatch(r"[a-z][a-z0-9_]*", sys.argv[1]):
        sys.exit("Usage: mise run generate-module <name>; name must match [a-z][a-z0-9_]*")
    name = sys.argv[1]
    root = Path(__file__).resolve().parent.parent
    source = Path(__file__).resolve().with_suffix(".d")
    target = root / "modules" / name
    if target.exists():
        sys.exit(f"Module already exists: {target}")
    title = "".join(part[:1].upper() + part[1:] for part in name.split("_"))
    target.mkdir(parents=True)
    try:
        for template in source.rglob("*.tpl"):
            relative_path = template.relative_to(source).with_suffix("")
            relative_path = Path(*(name if part == "template" else part for part in relative_path.parts))
            destination = target / relative_path
            destination.parent.mkdir(parents=True, exist_ok=True)
            text = template.read_text()
            text = text.replace("template", name).replace("Template", title).replace("TEMPLATE", name.upper())
            destination.write_text(text)
            if text.startswith("#!"):
                destination.chmod(0o755)
        env = dict(os.environ, GOWORK="off")
        subprocess.run(["mise", "run", f"//modules/{name}:generate"], cwd=root, env=env, check=True)
        subprocess.run(["mise", "exec", "--", "go", "work", "edit", f"-use=./modules/{name}"], cwd=root, check=True)
    except BaseException:
        shutil.rmtree(target)
        raise
    print(f"Created modules/{name}. Verify with: mise run //modules/{name}:all")


if __name__ == "__main__":
    main()
